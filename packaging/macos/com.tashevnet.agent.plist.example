<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Start TashevNet at login on macOS.

  1. Replace YOUR_USER and the paths below (launchd does not expand ~).
  2. cp com.tashevnet.agent.plist.example ~/Library/LaunchAgents/com.tashevnet.agent.plist
  3. launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.tashevnet.agent.plist

  Stop:   launchctl bootout gui/$(id -u)/com.tashevnet.agent
  Logs:   ~/Library/Logs/tashevnet.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tashevnet.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOUR_USER/tashevnet/.venv/bin/tashevnet</string>
    <string>--config</string>
    <string>/Users/YOUR_USER/tashevnet/config.yaml</string>
    <string>run</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd starts with a minimal PATH; add Homebrew so a self-heal command is found. -->
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/YOUR_USER/Library/Logs/tashevnet.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USER/Library/Logs/tashevnet.log</string>
</dict>
</plist>
