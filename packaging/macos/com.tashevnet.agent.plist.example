<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tashevnet.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/tashevnet</string>
    <string>--config</string>
    <string>/ABSOLUTE/PATH/config.yaml</string>
    <string>run</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/tashevnet.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/tashevnet.err</string>
</dict>
</plist>
